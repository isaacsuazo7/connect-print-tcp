{
  "name": "connect-print-tcp",
  "version": "2.0.0",
  "description": "Test TCP-Socket printer",
  "main": "index.js",
  "scripts": {
    "test": "node --experimental-sqlite --no-warnings --test \"test/*.test.js\"",
    "start": "nodemon --exec \"node --experimental-sqlite\" index.js",
    "build": "npx -y @vercel/ncc@0.38.1 build main.js -o dist",
    "packing": "npx -y @yao-pkg/pkg@6.10.1 -t node22-win-x64 --options experimental-sqlite,no-warnings dist/index.js -o dist/YaloPrinterService.exe"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Isaac Suazo",
  "license": "ISC",
  "dependencies": {
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "ip": "^2.0.1",
    "network": "^0.7.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.22"
  }
}
